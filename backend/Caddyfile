{
    admin off
    auto_https off
}

http://:{$PORT:8080} {
    handle /actuator/health {
        reverse_proxy 127.0.0.1:8081
    }
    handle /actuator/info {
        reverse_proxy 127.0.0.1:8081
    }
    handle /actuator/metrics* {
        reverse_proxy 127.0.0.1:8081
    }
    handle /api/* {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:8081
    }
    handle {
        respond 404
    }
}
